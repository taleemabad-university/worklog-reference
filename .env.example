# Copy this file to .env and fill it in:     cp .env.example .env
#
# .env is in .gitignore. It must NEVER be committed. If you ever push one by
# mistake, change the password - deleting the file does not remove it from
# your git history.
#
# YOU DO NOT NEED ANY OF THIS TO BUILD TODAY.
# python run_once.py --drop  reads .txt files out of the drop/ folder and
# needs no settings at all. Only fill this in if you want the mailbox.

# ── Mailbox (optional) ───────────────────────────────────────────────────
IMAP_HOST=imap.gmail.com
IMAP_USER=you@taleemabad.com

# Gmail: a 16-character APP PASSWORD from
# https://myaccount.google.com/apppasswords  - NOT your normal password.
# Spaces do not matter.
IMAP_PASSWORD=

# REQUIRED if you use the mailbox. Only emails whose subject contains this
# word are read. Without it the job refuses to run, so that it can never
# read your personal or HR mail by accident.
SUBJECT_FILTER=transcript

# ── Claude (optional) ────────────────────────────────────────────────────
# haiku is the default and it is the right choice today: fast and cheap.
# CLAUDE_HELPER_MODEL=haiku
